# ============================================================
# Coporate_Website — Environment Variables Template
# Copy this file to .env.local and fill in your values
# ============================================================

# ============================================================
# DEVELOPMENT MODE (Optional)
# ============================================================

# Set to 'true' to use mock data instead of Supabase (for local development)
# When this is true, the app will use mockJobs and mockNews from lib/mock-data.ts
# instead of querying the Supabase database.
# This is useful when:
#   - You don't have Supabase credentials set up
#   - You want to develop without a database connection
#   - You're demoing the app and don't have real data
USE_MOCK_DATA=true

# ============================================================
# SUPABASE (Required when USE_MOCK_DATA=false)
# ============================================================

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anonymous key (safe for client-side, subject to RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (NEVER expose to client, server-side only, NEVER commit real values)
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# APPLICATION (Optional)
# ============================================================

# Site URL for metadata, OG images, etc.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# NOTES
# ============================================================
# 1. NEVER commit .env.local to version control
# 2. Add .env.local to your .gitignore
# 3. Get Supabase keys from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# 4. Never expose SUPABASE_SERVICE_ROLE_KEY to the client
# 5. For local development, you can use `supabase link` and `supabase env` to pull values
# ============================================================
# Coporate_Website — Environment Variables Template
# Copy this file to .env.local and fill in your values
# ============================================================

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================

# PostgreSQL connection string (Postgres/Supabase/etc.)
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Use MOCK data for local dev or when database is unavailable.
# Set to 'false' to enable PostgreSQL database mode.
# If false, DATABASE_URL must be valid.
USE_MOCK_DATA=true

# Mock Data Login Credentials (when USE_MOCK_DATA=true)
# Email: admin@example.com
# Password: mock-admin-local-only

# ============================================================
# APPLICATION (Optional)
# ============================================================

# Site URL for metadata, OG images, etc.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# NOTES
# ============================================================
# 1. NEVER commit .env.local to version control
# 2. Add .env.local to your .gitignore
# 3. PostgreSQL migrations are automatically applied on application startup

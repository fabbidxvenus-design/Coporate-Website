# ============================================================
# Coporate_Website — Environment Variables Template
# Copy this file to .env.local and fill in your values
# ============================================================

# ============================================================
# PAYLOAD CMS (required for CMS admin UI)
# ============================================================

# Payload CMS secret — generate with: openssl rand -base64 32
# Required for Payload admin UI at /admin
PAYLOAD_SECRET=your-secret-at-least-32-characters

# Payload public URL (used for admin and API)
# For local dev: http://localhost:3000
PAYLOAD_URL=http://localhost:3000

# Payload collection slugs (defaults shown — only override if renamed)
# PAYLOAD_COLLECTION_JOBS=jobs
# PAYLOAD_COLLECTION_ARTICLES=articles
# PAYLOAD_COLLECTION_APPLICATIONS=applications
# PAYLOAD_COLLECTION_MEDIA=media
# PAYLOAD_COLLECTION_SITE_SETTINGS=site-settings
# PAYLOAD_COLLECTION_ABOUT_PAGES=about-pages

# Payload revalidation webhook secret (optional, for cache revalidation)
# PAYLOAD_REVALIDATE_SECRET=your-revalidate-secret

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================

# PostgreSQL connection string for Payload CMS storage.
# Local dev default: postgres://user:password@localhost:5432/dbname
# Supabase: use the connection string from Supabase dashboard > Settings > Database
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# ============================================================
# DATA SOURCE MODE
# ============================================================

# Controls which backend serves content:
#   (not set / USE_MOCK_DATA=false) → Payload CMS if PAYLOAD_SECRET set, else Postgres
#   USE_MOCK_DATA=true             → Mock data only (no external deps, for tests/emergency)
#
# For local development with Payload CMS:
#   → Set USE_MOCK_DATA=false (or leave unset) + PAYLOAD_SECRET + DATABASE_URL
#
# For mock-only local development (no DB, no Payload):
#   → Set USE_MOCK_DATA=true
# USE_MOCK_DATA=false

# ============================================================
# APPLICATION (Optional)
# ============================================================

# Site URL for metadata, OG images, etc.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# NOTES
# ============================================================
# 1. NEVER commit .env.local to version control
# 2. Add .env.local to your .gitignore
# 3. See coding-packs/payload/setup.md for full Payload CMS setup guide
# 4. Payload admin UI: http://localhost:3000/admin
# 5. To init Payload: pnpm dev → visit /admin → create admin account